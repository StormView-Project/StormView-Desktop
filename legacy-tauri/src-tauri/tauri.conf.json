{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StormView",
  "version": "1.0.0",
  "identifier": "com.arc360hub.stormview",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "StormView",
        "width": 1440,
        "height": 900,
        "minWidth": 380,
        "minHeight": 560,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "nsis", "msi"],
    "category": "Weather",
    "shortDescription": "Live radar and weather alerts",
    "longDescription": "StormView desktop: LibreWXR radar, Open-Meteo and NWS forecasts, NWS alert polygons and native alert notifications, styled with Material 3 Expressive.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
