import { MaterialWindow, MaterialPalette, ScrollView, TextField, CircularProgressIndicator } from "@material";
import { Palette } from "std-widgets.slint";
import { MapView } from "map.slint";
import { WeatherContent } from "widgets.slint";
import { Scrubber } from "scrubber.slint";
import { SettingsSheet } from "settings.slint";
import { Dialogs } from "dialogs.slint";
import { T, Icon, Shape, Pill, ToolButton, GroupButton, Motion, Btn, PressFx, Feel } from "common.slint";
import { MapBridge, Weather, Radar, Prefs, Ui } from "globals.slint";

export { MaterialPalette, MaterialSchemes, MaterialScheme, MenuItem } from "@material";
export * from "globals.slint";

import "fonts/GoogleSansFlexRounded-Regular.ttf";
import "fonts/GoogleSansFlexRounded-Medium.ttf";
import "fonts/GoogleSansFlexRounded-Bold.ttf";
import "fonts/GoogleSansFlexRounded-Light.ttf";

component LocationHeader inherits HorizontalLayout {
    padding: 8px;
    padding-left: 6px;
    spacing: 6px;
    height: 60px;
    loc := Rectangle {
        border-radius: Feel.morph && lta.pressed ? 12px : 20px;
        animate border-radius { duration: 250ms; easing: Motion.spring; }
        horizontal-stretch: 1;
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 6px;
            VerticalLayout { alignment: center; Icon { name: "location_on-fill"; size: 22px; tint: MaterialPalette.primary; } }
            if Weather.has-location: Text { text: Weather.location-name; font-size: 17px; font-weight: 700; color: MaterialPalette.on_surface; vertical-alignment: center; overflow: elide; }
            if Weather.has-location: Text { text: Weather.location-state; font-size: 14px; color: MaterialPalette.on_surface_variant; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
            if !Weather.has-location: Text { text: "Set your location"; font-size: 16px; font-weight: 600; color: MaterialPalette.primary; vertical-alignment: center; horizontal-stretch: 1; }
        }
        lta := PressFx { radius: loc.border-radius; clicked => { Ui.settings-tab = 0; Ui.settings-open = true; } }
    }
    if Weather.has-location && Weather.source != "": VerticalLayout { alignment: center; Pill { text: Weather.source; } }
    if Weather.has-location: Rectangle {
        width: 44px;
        if Weather.loading: CircularProgressIndicator { indeterminate: true; width: 22px; height: 22px; }
        if !Weather.loading: ToolButton { icon: "refresh"; size: 44px; clicked => { Weather.refresh(); } }
    }
}

component AlertBanner inherits Rectangle {
    property <int> idx;
    property <int> i: min(idx, Weather.alerts.length - 1);
    visible: Weather.alerts.length > 0;
    height: Weather.alerts.length > 0 ? 48px : 0;
    border-radius: 20px;
    background: Weather.alerts.length > 0 ? Weather.alerts[i].tint.container : transparent;
    if Weather.alerts.length > 0: HorizontalLayout {
        padding-left: 14px;
        padding-right: 6px;
        spacing: 6px;
        VerticalLayout { alignment: center; Icon { name: "warning-fill"; size: 20px; tint: Weather.alerts[root.i].tint.color; } }
        Text { text: Weather.alerts[root.i].title; color: Weather.alerts[root.i].tint.on-container; font-size: 14px; font-weight: 600; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        if Weather.alerts.length > 1: VerticalLayout { alignment: center; ToolButton { icon: "chevron_left"; size: 32px; clicked => { root.idx = mod(root.i - 1 + Weather.alerts.length, Weather.alerts.length); } } }
        if Weather.alerts.length > 1: Text { text: (root.i + 1) + "/" + Weather.alerts.length; font-size: 11px; color: Weather.alerts[root.i].tint.on-container; vertical-alignment: center; }
        if Weather.alerts.length > 1: VerticalLayout { alignment: center; ToolButton { icon: "chevron_right"; size: 32px; clicked => { root.idx = mod(root.i + 1, Weather.alerts.length); } } }
        VerticalLayout { alignment: center; Rectangle {
            width: btn.preferred-width + 24px;
            height: 32px;
            border-radius: Feel.morph && dfx.pressed ? 8px : 16px;
            animate border-radius { duration: 250ms; easing: Motion.spring; }
            background: Weather.alerts[root.i].tint.color;
            btn := Text { text: Weather.alerts.length > 1 ? "See all" : "Details"; color: Weather.alerts[root.i].tint.container; font-size: 13px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
            dfx := PressFx {
                radius: parent.border-radius;
                ink: Weather.alerts[root.i].tint.container;
                clicked => { Weather.dialog-title = Weather.alerts.length > 1 ? "Active alerts (" + Weather.alerts.length + ")" : Weather.alerts[root.i].title; Weather.dialog-alerts = Weather.alerts; Ui.alert-dialog-open = true; }
            }
        } }
    }
}

component WeatherScroll inherits ScrollView {
    content-height: content.preferred-height;
    content := VerticalLayout {
        width: root.visible-width;
        padding: 12px;
        padding-top: 0;
        WeatherContent { }
    }
}

component Toolbar inherits Rectangle {
    in property <bool> compact;
    height: 64px;
    width: row.preferred-width;
    border-radius: 32px;
    background: MaterialPalette.surface_container_high;
    drop-shadow-blur: 12px;
    drop-shadow-color: #00000040;
    drop-shadow-offset-y: 3px;
    row := HorizontalLayout {
        padding: 8px;
        spacing: 6px;
        if !root.compact: Rectangle {
            width: beta.preferred-width + 24px;
            border-radius: Feel.morph && bta.pressed ? 12px : 24px;
            animate border-radius { duration: 250ms; easing: Motion.spring; }
            beta := Text { text: "BETA"; font-weight: 800; letter-spacing: 1.5px; font-size: 13px; color: MaterialPalette.tertiary; horizontal-alignment: center; vertical-alignment: center; }
            bta := PressFx { radius: parent.border-radius; clicked => { Ui.beta-open = true; } }
        }
        HorizontalLayout {
            spacing: 2px;
            GroupButton { text: "Radar"; first: true; selected: Prefs.map-layer == "radar"; height: 48px; clicked => { Prefs.set-str("mapLayer", "radar"); } }
            GroupButton { text: "Air"; last: true; selected: Prefs.map-layer == "aqi"; height: 48px; clicked => { Prefs.set-str("mapLayer", "aqi"); } }
        }
        ToolButton {
            icon: "satellite_alt";
            selected: Prefs.radar-toggles.length > 4 && Prefs.radar-toggles[4].on;
            clicked => { Prefs.set-bool("showSatellite", !(Prefs.radar-toggles.length > 4 && Prefs.radar-toggles[4].on)); }
        }
        if !root.compact: ToolButton {
            icon: "settings-fill";
            filled: true;
            selected: Ui.settings-open;
            clicked => { Ui.settings-open = !Ui.settings-open; }
        }
    }
}

component ZoomButtons inherits Rectangle {
    width: 48px;
    height: 104px;
    border-radius: 24px;
    background: MaterialPalette.surface_container_high;
    drop-shadow-blur: 8px;
    drop-shadow-color: #00000033;
    VerticalLayout {
        padding: 4px;
        spacing: 4px;
        ToolButton { icon: "add"; size: 40px; clicked => { MapBridge.zoom(1, -1, -1); } }
        ToolButton { icon: "remove"; size: 40px; clicked => { MapBridge.zoom(-1, -1, -1); } }
    }
}

component AqiLegend inherits Rectangle {
    height: col.preferred-height;
    border-radius: 24px;
    background: MaterialPalette.surface_container;
    drop-shadow-blur: 12px;
    drop-shadow-color: #00000040;
    col := VerticalLayout {
        padding: 14px;
        padding-left: 18px;
        padding-right: 18px;
        spacing: 8px;
        T { text: "US Air Quality Index"; role: "title-small"; }
        Rectangle {
            height: 14px;
            border-radius: 7px;
            background: @linear-gradient(90deg, #00c853 0%, #e8c200 20%, #ff7e00 40%, #ff1f1f 60%, #8f3f97 80%, #7e0023 100%);
        }
        HorizontalLayout {
            T { text: "Good"; role: "label-small"; muted: true; horizontal-stretch: 1; }
            T { text: "Moderate"; role: "label-small"; muted: true; horizontal-stretch: 1; }
            T { text: "Unhealthy"; role: "label-small"; muted: true; horizontal-stretch: 1; }
            T { text: "Hazardous"; role: "label-small"; muted: true; }
        }
        T { text: "Click the map for exact readings"; role: "label-small"; muted: true; }
    }
}

export component AppWindow inherits MaterialWindow {
    title: "StormView";
    icon: @image-url("app-icon.png");
    preferred-width: 1440px;
    preferred-height: 900px;
    min-width: 380px;
    min-height: 560px;
    default-font-family: "Google Sans Flex Rounded";
    in property <bool> dark;
    callback zoom-settled(float);
    init => { Palette.color-scheme = dark ? ColorScheme.dark : ColorScheme.light; keys.focus(); }
    changed dark => { Palette.color-scheme = dark ? ColorScheme.dark : ColorScheme.light; }

    property <bool> compact: Prefs.compact && self.width < 760px;
    property <bool> left: Prefs.sidebar != "right";
    property <length> side-w: self.width < 1100px ? 360px : 400px;
    property <length> gap: 12px;

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(e) => {
            if (e.modifiers.control && e.text == ",") || e.text == Key.F2 { Ui.settings-open = !Ui.settings-open; return accept; }
            if e.text == Key.F3 && Ui.settings-open { Ui.settings-tab = mod(Ui.settings-tab + 1, 7); return accept; }
            if e.modifiers.control && e.text == Key.Tab && Ui.settings-open {
                Ui.settings-tab = mod(Ui.settings-tab + (e.modifiers.shift ? 6 : 1), 7);
                return accept;
            }
            if e.text == " " { Radar.toggle-play(); return accept; }
            if e.text == "+" || e.text == "=" { MapBridge.zoom(1, -1, -1); return accept; }
            if e.text == "-" { MapBridge.zoom(-1, -1, -1); return accept; }
            if e.text == Key.LeftArrow { Radar.seek(max(0, Radar.index - 1)); return accept; }
            if e.text == Key.RightArrow { Radar.seek(min(Radar.count - 1, Radar.index + 1)); return accept; }
            if e.text == Key.Escape { Ui.settings-open = false; Ui.assistant-open = false; return accept; }
            reject
        }
    }

    MapView { }

    // ------------------------------------------------------------ desktop layout
    if !root.compact: Rectangle {
        x: root.left ? root.gap : root.width - root.side-w - root.gap;
        y: root.gap;
        width: root.side-w;
        height: root.height - 2 * root.gap;
        border-radius: 28px;
        background: MaterialPalette.surface_container_low;
        drop-shadow-blur: 16px;
        drop-shadow-color: #0000004d;
        drop-shadow-offset-y: 4px;
        clip: true;
        TouchArea { }
        VerticalLayout {
            LocationHeader { }
            HorizontalLayout { padding-left: 12px; padding-right: 12px; padding-bottom: Weather.alerts.length > 0 ? 8px : 0; AlertBanner { } }
            WeatherScroll { vertical-stretch: 1; }
        }
    }

    if !root.compact: Toolbar {
        x: root.left ? root.width - self.width - root.gap : root.gap;
        y: root.gap;
    }

    ZoomButtons {
        x: root.compact ? root.width - self.width - root.gap : root.left ? root.width - self.width - root.gap : root.gap;
        y: root.compact ? 88px : 88px;
        visible: !root.compact || Ui.compact-tab == 1;
    }

    if !root.compact: Rectangle {
        property <length> l: root.left ? root.side-w + 2 * root.gap : 96px;
        property <length> r: root.left ? 96px : root.side-w + 2 * root.gap;
        x: self.l + max(0, (root.width - self.l - self.r - self.width) / 2);
        width: min(680px, root.width - self.l - self.r);
        y: root.height - self.height - root.gap;
        height: Prefs.map-layer == "radar" ? scrub.height : legend.height;
        scrub := Scrubber { visible: Prefs.map-layer == "radar"; width: parent.width; }
        legend := AqiLegend { visible: Prefs.map-layer == "aqi"; width: parent.width; }
    }

    // ------------------------------------------------------------ compact layout
    if root.compact && Ui.compact-tab == 0: Rectangle {
        height: root.height - 80px;
        y: 0;
        background: MaterialPalette.surface;
        TouchArea { }
        VerticalLayout {
            LocationHeader { }
            HorizontalLayout { padding-left: 12px; padding-right: 12px; padding-bottom: Weather.alerts.length > 0 ? 8px : 0; AlertBanner { } }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-bottom: 8px;
                Rectangle {
                    height: 76px;
                    border-radius: Feel.morph && rca.pressed ? 36px : 24px;
                    animate border-radius { duration: 300ms; easing: Motion.spring; }
                    background: MaterialPalette.surface_container;
                    HorizontalLayout {
                        padding: 10px;
                        spacing: 14px;
                        Shape { name: "soft-burst"; size: 56px; fill: MaterialPalette.primary_container; Icon { x: 16px; y: 16px; name: "radar-fill"; tint: MaterialPalette.on_primary_container; } }
                        VerticalLayout { alignment: center; horizontal-stretch: 1; T { text: "Live radar"; role: "title-medium"; } T { text: Radar.count > 0 ? "Latest frame " + Radar.time : "Loading…"; role: "body-small"; muted: true; } }
                        VerticalLayout { alignment: center; Icon { name: "chevron_right"; } }
                    }
                    rca := PressFx { radius: parent.border-radius; clicked => { Ui.compact-tab = 1; } }
                }
            }
            WeatherScroll { vertical-stretch: 1; }
        }
    }
    if root.compact && Ui.compact-tab == 1: Toolbar {
        compact: true;
        x: (root.width - self.width) / 2;
        y: root.gap;
    }
    if root.compact && Ui.compact-tab == 1: Rectangle {
        x: root.gap;
        width: root.width - 2 * root.gap;
        y: root.height - 80px - self.height - root.gap;
        height: Prefs.map-layer == "radar" ? cscrub.height : clegend.height;
        cscrub := Scrubber { visible: Prefs.map-layer == "radar"; width: parent.width; }
        clegend := AqiLegend { visible: Prefs.map-layer == "aqi"; width: parent.width; }
    }
    // M3 navigation bar (compact layout): pill indicator behind the selected icon.
    if root.compact: nav := Rectangle {
        property <int> current: Ui.settings-open ? 2 : Ui.compact-tab;
        y: root.height - self.height;
        width: root.width;
        height: 80px;
        background: MaterialPalette.surface_container;
        HorizontalLayout {
            for it[i] in [
                { icon: "home", label: "Home" },
                { icon: "radar", label: "Radar" },
                { icon: "settings", label: "Settings" },
            ]: Rectangle {
                horizontal-stretch: 1;
                VerticalLayout {
                    alignment: center;
                    spacing: 4px;
                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: nav.current == i ? 64px : 32px;
                            height: 32px;
                            border-radius: 16px;
                            background: nav.current == i ? MaterialPalette.secondary_container : transparent;
                            animate width { duration: 300ms; easing: Motion.spring; }
                            Icon {
                                name: nav.current == i ? it.icon + "-fill" : it.icon;
                                tint: nav.current == i ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface_variant;
                            }
                        }
                    }
                    Text { text: it.label; font-size: 12px; font-weight: 600; color: MaterialPalette.on_surface_variant; horizontal-alignment: center; }
                }
                PressFx {
                    clicked => {
                        if i == 2 { Ui.settings-open = true; } else { Ui.settings-open = false; Ui.compact-tab = i; }
                    }
                }
            }
        }
    }

    // ------------------------------------------------------------ assistant
    property <length> chat-w: min(400px, root.width - 32px);
    if Ui.assistant-open: Rectangle {
        x: root.left || root.compact ? root.width - self.width - 16px : 16px;
        y: root.height - self.height - (root.compact ? 168px : 104px);
        width: root.chat-w;
        height: min(540px, root.height - 200px);
        border-radius: 28px;
        background: MaterialPalette.surface_container;
        drop-shadow-blur: 18px;
        drop-shadow-color: #0000004d;
        clip: true;
        TouchArea { }
        VerticalLayout {
            HorizontalLayout {
                padding: 12px;
                padding-left: 16px;
                spacing: 10px;
                Shape {
                    name: "flower";
                    size: 38px;
                    fill: MaterialPalette.tertiary_container;
                    Icon { x: 9px; y: 9px; name: "smart_toy-fill"; size: 20px; tint: MaterialPalette.on_tertiary_container; }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    T { text: "Weather Assistant"; role: "title-medium"; }
                    T { text: Ui.chat-model-label; role: "label-small"; muted: true; }
                }
                ToolButton { icon: "delete_sweep"; size: 40px; clicked => { Ui.clear-chat(); } }
                ToolButton { icon: "close"; size: 40px; clicked => { Ui.assistant-open = false; } }
            }
            if !Ui.chat-ready: VerticalLayout {
                padding: 24px;
                spacing: 12px;
                alignment: center;
                vertical-stretch: 1;
                T { text: "Connect a local model (Ollama or an OpenAI-compatible server) to chat about your forecast."; muted: true; wrap: word-wrap; horizontal-alignment: center; }
                HorizontalLayout { alignment: center; Btn { text: "Set up assistant"; clicked => { Ui.settings-tab = 6; Ui.settings-open = true; } } }
            }
            if Ui.chat-ready: log := ScrollView {
                vertical-stretch: 1;
                content-height: msgs.preferred-height;
                changed content-height => { self.content-y = min(0px, self.visible-height - self.content-height); }
                msgs := VerticalLayout {
                    width: log.visible-width;
                    padding: 16px;
                    spacing: 8px;
                    if Ui.chat.length == 0: VerticalLayout {
                        spacing: 8px;
                        T { text: "Ask me anything about your weather."; muted: true; }
                        for q in ["Will it rain today?", "What should I wear?", "Any alerts right now?", "Warmest day this week?"]: HorizontalLayout {
                            alignment: start;
                            Rectangle {
                                border-radius: Feel.morph && sqa.pressed ? 16px : 8px;
                                animate border-radius { duration: 250ms; easing: Motion.spring; }
                                border-width: 1px;
                                border-color: MaterialPalette.outline_variant;
                                HorizontalLayout { padding: 8px; padding-left: 14px; padding-right: 14px; T { text: q; role: "label-large"; } }
                                sqa := PressFx { radius: parent.border-radius; clicked => { Ui.send-chat(q); } }
                            }
                        }
                    }
                    for m in Ui.chat: HorizontalLayout {
                        alignment: m.user ? end : start;
                        Rectangle {
                            max-width: log.visible-width * 0.82;
                            border-radius: 20px;
                            background: m.user ? MaterialPalette.primary : MaterialPalette.surface_container_highest;
                            HorizontalLayout {
                                padding: 10px;
                                padding-left: 14px;
                                padding-right: 14px;
                                if m.text == "": CircularProgressIndicator { indeterminate: true; width: 20px; height: 20px; }
                                if m.text != "": Text { text: m.text; wrap: word-wrap; font-size: 14px; color: m.user ? MaterialPalette.on_primary : MaterialPalette.on_surface; }
                            }
                        }
                    }
                }
            }
            if Ui.chat-ready: HorizontalLayout {
                padding: 12px;
                spacing: 8px;
                input := TextField {
                    horizontal-stretch: 1;
                    label: "Ask about the weather…";
                    enabled: !Ui.chat-busy;
                    accepted(t) => { Ui.send-chat(t); self.text = ""; }
                }
                VerticalLayout { alignment: center; ToolButton {
                    icon: "send-fill";
                    filled: true;
                    clicked => { Ui.send-chat(input.text); input.text = ""; }
                } }
            }
        }
    }
    Rectangle {
        x: root.left || root.compact ? root.width - self.width - 16px : 16px;
        y: root.height - self.height - (root.compact ? 96px : 32px);
        width: 64px;
        height: 64px;
        border-radius: Ui.assistant-open || (Feel.morph && fta.pressed) ? 32px : 18px;
        background: Ui.assistant-open ? MaterialPalette.secondary_container : MaterialPalette.tertiary_container;
        drop-shadow-blur: 10px;
        drop-shadow-color: #00000040;
        drop-shadow-offset-y: 3px;
        animate border-radius { duration: 400ms; easing: Motion.spring; }
        Icon {
            name: Ui.assistant-open ? "close" : "smart_toy-fill";
            size: 26px;
            tint: Ui.assistant-open ? MaterialPalette.on_secondary_container : MaterialPalette.on_tertiary_container;
        }
        fta := PressFx { radius: parent.border-radius; clicked => { Ui.assistant-open = !Ui.assistant-open; } }
    }

    // ------------------------------------------------------------ overlays
    SettingsSheet { left-side: !root.left; }
    Dialogs { }

    Rectangle {
        x: (root.width - self.width) / 2;
        y: root.height - (Ui.toast-visible ? self.height + (root.compact ? 96px : 200px) : -60px);
        width: min(560px, root.width - 32px);
        height: 48px;
        border-radius: 12px;
        background: MaterialPalette.inverse_surface;
        opacity: Ui.toast-visible ? 1 : 0;
        animate y { duration: 420ms; easing: Motion.spring; }
        animate opacity { duration: 200ms; }
        Text { x: 16px; width: parent.width - 32px; text: Ui.toast; color: MaterialPalette.inverse_on_surface; font-size: 14px; vertical-alignment: center; overflow: elide; }
    }
}
